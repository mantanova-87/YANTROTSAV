# ==============================================================================
# YANTROTSAV 2026 - ENVIRONMENT CONFIGURATION (PLACEHOLDERS)
# ==============================================================================
# Duplicate this file to .env or .env.local and update with your actual credentials.

# ------------------------------------------------------------------------------
# APPWRITE BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Appwrite API Endpoint (Default is cloud.appwrite.io or self-hosted endpoint)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Project ID (Found in Appwrite Console > Project Settings)
VITE_APPWRITE_PROJECT_ID=placeholder_project_id

# Appwrite Database ID
VITE_APPWRITE_DATABASE_ID=TablesDB

# Database Collection / Table IDs
VITE_APPWRITE_COLLECTION_USERS=users
# Create a UNIQUE index on users.userId in Appwrite. The app stores normalized lowercase usernames here.
VITE_APPWRITE_COLLECTION_EVENTS=events
VITE_APPWRITE_COLLECTION_TEAMS=teams
VITE_APPWRITE_COLLECTION_TEAM_INVITATIONS=team_invitations
VITE_APPWRITE_COLLECTION_EVENT_REGISTRATIONS=event_registrations

# Appwrite Storage Bucket ID (For event banners, assets, student IDs)
VITE_APPWRITE_STORAGE_BUCKET_ID=placeholder_storage_bucket_id

# Appwrite Admin Team ID (Used for RBAC checks)
VITE_APPWRITE_ADMIN_TEAM_ID=placeholder_admin_team_id

# Server-only Appwrite API key used by registration and account deletion. Never prefix this with VITE_;
# it needs Users read/write and Databases read/write scopes.
APPWRITE_API_KEY=placeholder_server_only_api_key

# ------------------------------------------------------------------------------
# FRONTEND / APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Base URL for invitation links and callbacks
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# VERCEL SERVERLESS & EMAIL (SMTP)
# ------------------------------------------------------------------------------
# Gmail SMTP Credentials used by api/contact.ts and api/send-invite.ts
GMAIL_USER=placeholder_email@gmail.com
GMAIL_APP_PASSWORD=placeholder_google_app_password
